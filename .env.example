# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Flask core ────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(64))"
# The app will REFUSE to start in production if this is not set.
FLASK_SECRET_KEY=change-this-to-a-long-random-string

# "development" enables DEBUG mode and the interactive debugger.
# Leave unset or set to "production" for any deployed environment.
FLASK_ENV=production

# ── Database ──────────────────────────────────────────────────────────────
# Local development: a relative path works fine.
# Docker / AWS: use an absolute path on a mounted persistent volume.
#   On AWS EB with Docker, mount an EBS volume at /data and set:
#   DATABASE_PATH=/data/prepmate.db
#
# WARNING: Without a persistent volume mount, the database is stored inside
# the container and will be lost on every deployment or instance replacement.
DATABASE_PATH=prepmate.db

# ── AWS Bedrock (for the AI Planner) ──────────────────────────────────────
# On AWS EC2 / Elastic Beanstalk, prefer attaching an IAM role with the
# bedrock:InvokeModel permission to the instance.  Leave the keys below
# blank and boto3 will use the instance role automatically.
#
# Only set these when running outside AWS (e.g. local development with a
# real Bedrock call).  The app falls back to the rule-based planner if
# credentials are absent or if the API call fails.
#
# Required IAM permission:
#   bedrock:InvokeModel on arn:aws:bedrock:<region>::foundation-model/<model-id>
# Model access must be enabled in: AWS Console → Bedrock → Model access
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
BEDROCK_TIMEOUT=30
